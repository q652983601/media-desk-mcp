# Local service; default does not call any model or paid API.
MEDIA_DESK_HOST=127.0.0.1
MEDIA_DESK_PORT=4319
# MEDIA_DESK_DATA_DIR=/absolute/path/to/media-desk-data
# Non-loopback listening requires a token and explicit hostnames.
# MEDIA_DESK_TOKEN=choose-a-long-private-token
# MEDIA_DESK_ALLOWED_HOSTS=your-lab-host:4319
# MEDIA_DESK_PUBLIC_URL=https://your-private-media-desk.example

# Optional installed/logged-in CLI engines; these use the CLI's own account.
# Enabling an engine is separate from MCP clients connecting to this service.
# MEDIA_DESK_AGENTS=codex,kimi

# Optional OpenAI-compatible API; configured use may incur provider charges.
# MEDIA_DESK_BASE_URL=https://your-provider.example/v1
# MEDIA_DESK_MODEL=your-model-id
# MEDIA_DESK_API_KEY=read-from-your-secret-store

# Paid account import stays disabled unless explicitly enabled.
MEDIA_DESK_ENABLE_MONID=0
