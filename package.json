{
  "name": "media-desk-mcp",
  "version": "0.1.0",
  "description": "Standalone self-media workspace with the original Media Desk frontend, MCP access, and optional Codex/Kimi runtimes.",
  "type": "module",
  "main": "standalone/server.mjs",
  "exports": {
    ".": "./standalone/server.mjs",
    "./mcp": "./standalone/mcp-tools.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "mcp",
    "content-creation",
    "codex",
    "kimi",
    "media-workspace"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/q652983601/media-desk-mcp.git"
  },
  "homepage": "https://github.com/q652983601/media-desk-mcp#readme",
  "bugs": "https://github.com/q652983601/media-desk-mcp/issues",
  "scripts": {
    "start": "node standalone/cli.mjs",
    "mcp": "node standalone/mcp.mjs",
    "build": "node scripts/build-standalone.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test": "node scripts/test.mjs",
    "verify:frontend": "node scripts/verify-frontend.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "^0.2.1-rc.2",
    "@modelcontextprotocol/client": "2.4.0",
    "esbuild": "^0.25.10",
    "playwright": "1.62.1"
  },
  "files": [
    "src",
    "client",
    "standalone",
    "dist/standalone",
    "assets",
    "scripts",
    "docs",
    "mcp.example.json",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "private": true,
  "bin": {
    "media-desk": "standalone/cli.mjs",
    "media-desk-mcp": "standalone/mcp.mjs"
  }
}
